{
  "_comment": "独立无量纲公式构造与两阶段拟合配置；stage 可选 generate/fit/all。",
  "stage": "all",
  "minimal_output_artifacts": true,
  "require_integer_exponents": true,
  "pysr_baseline": {
    "enabled": false,
    "reproducibility_mode": "reproducible",
    "niterations": 500,
    "final_validation_r2_window": 0.1,
    "populations": 20,
    "population_size": 20,
    "maxsize": 20,
    "binary_operators": [
      "+",
      "-",
      "*",
      "/"
    ],
    "unary_operators": [
      "sin",
      "cos",
      "log_abs(x) = log(abs(x))",
      "log_abs_sin(x) = log(abs(sin(x)))",
      "log_abs_cos(x) = log(abs(cos(x)))"
    ],
    "model_selection": "best",
    "verbosity": 1,
    "precision": 64,
    "optimizer_algorithm": "BFGS",
    "optimizer_nrestarts": 20,
    "optimizer_iterations": 8,
    "optimizer_f_calls_limit": 10000,
    "process_watchdog_enabled": true,
    "process_watchdog_grace_seconds": 60,
    "pysr_iteration_timeout_seconds": 100,
    "process_watchdog_iteration_timeout_seconds": 160,
    "process_watchdog_startup_timeout_seconds": 1800,
    "optimize_probability": 0.14,
    "should_optimize_constants": true,
    "constant_refit_gtol": 1e-05,
    "constant_refit_initialization_range": [
      -10.0,
      10.0
    ],
    "require_all_features": true,
    "forbid_nested_nonlinear_operators": true,
    "forbid_division_by_nonlinear_structure": true,
    "max_nonconstant_additive_terms": 2,
    "structural_loss_during_search": true,
    "structural_loss_penalty": 1e+300,
    "forbid_bfgs_constants_in_power_exponents": true,
    "require_log_ancestor_for_x1": true,
    "require_optimizer_success": false,
    "shared_template": {
      "enabled": true,
      "parameter_count": 4
    }
  },
  "seed": 1518,
  "log_level": "INFO",
  "postprocessing": {
    "merge_log_max_r2_drop": 0.01,
    "log_merge_initial_perturbation": 0.05
  },
  "mode5_fit_batch_rounds": 5,
  "mode5_constant_test_timeout_seconds": 210,
  "periodic_constant_significance_enabled": true,
  "data": {
    "mode": "realdata_mat",
    "realdata": {
      "name": "measured_pathloss",
      "mat_path": "plot_data2.mat",
      "segmentation": {
        "enabled": true,
        "min_segment_samples": 10,
        "warm_start_perturbation": 0,
        "independent_segment_fitting": true,
        "breakpoint_prior": {
          "enabled": true,
          "h_t_m": 25.0,
          "h_r_m": 4.0,
          "carrier_frequency_hz": 5800000000.0,
          "speed_of_light_m_per_s": 299792458.0,
          "meters_to_data_units": 0.001,
          "regularization_weight": 1000.0
        }
      }
    },
    "csv_path": "standardized_pathloss_dataset_LHS_freq1.csv",
    "features": [
      "tx_rx_distance",
      "tx_height"
    ],
    "target": "path_loss",
    "csv_files": [
      {
        "name": "cruise",
        "csv_path": "standardized_pathloss_dataset_measured_0123_cruise.csv"
      }
    ],
    "split": {
      "seed": 1558,
      "train_fraction": 0.5,
      "validation_fraction": 0.25,
      "test_fraction": 0.25
    }
  },
  "fitting": {
    "single_sample_count": 20,
    "combination_sample_count": 60,
    "fit_mode": "refit",
    "optimizer": "LM",
    "lm_initializations": 20,
    "max_nfev": 5000,
    "log_merge_lm_initializations": 20,
    "zero_constant_lm_initializations": 20,
    "zero_constant_initial_perturbation": 0.05,
    "patience": 20,
    "initialization_range": [
      -10.0,
      10.0
    ],
    "minimum_valid_fraction": 0.9,
    "complex_tolerance": 1e-12,
    "max_abs_value": 1e+150,
    "share_constants_across_datasets": false,
    "joint_r2_aggregation": "minimum",
    "invalid_residual_penalty": 1000000.0
  },
  "ranking": {
    "enabled": true,
    "ablation_enabled": false,
    "model_type": "extra_trees",
    "minimum_training_samples": 20,
    "direct_fit_top_k": 5,
    "validation_fraction": 0.2,
    "validation_top_k": 10,
    "feature_correlation": {
      "enabled": false,
      "sample_size": 300
    },
    "refit_top_k": 15,
    "refit_lm_initializations": 20,
    "r2_floor": -2,
    "n_estimators": 500,
    "max_depth": null,
    "min_samples_leaf": 2,
    "max_features": 1.0,
    "n_jobs": 24,
    "learning_rate": 0.05,
    "subsample": 0.9,
    "colsample_bytree": 0.9,
    "reg_lambda": 1.0
  },
  "output": {
    "directory": "artifacts/expri2"
  }
}
